DISCORD_BOT_TOKEN=
# Optional override; Homebrew Opus is detected automatically on macOS.
DISCORD_OPUS_LIBRARY=
# Local Whisper speech-to-text defaults. This profile favors accuracy over the
# lower CPU and memory use of the tiny and base models.
WHISPER_MODEL=small
WHISPER_THREADS=6
# Ollama is a separate model used only for report generation.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
